# GEMINI_API_KEY: Required for Gemini AI API calls (Admin-only "Ask AI" tool on server).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_SECRET_CODE: Secret passcode for hidden Admin Panel access (Gmail/Phone + Secret Code).
# If unset in preview, claim the secret passcode once via the hidden Admin setup form.
ADMIN_SECRET_CODE=

# APP_URL: The URL where this applet is hosted (e.g., https://lifecircle.bd).
APP_URL="MY_APP_URL"

# GOOGLE_SITE_VERIFICATION: Verification token from Google Search Console HTML tag.
GOOGLE_SITE_VERIFICATION=

# GOOGLE_SITE_VERIFICATION_FILE: Optional HTML file verification filename (e.g., google1234567890abcdef.html).
GOOGLE_SITE_VERIFICATION_FILE=

